{
  "name": "orders-post",
  "priority": 5,
  "request": {
    "method": "POST",
    "urlPath": "/orders"
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "id": "ord-{{randomValue type='ALPHANUMERIC' length=8 uppercase=true}}",
      "status": "CREATED",
      "createdAt": "{{now format='yyyy-MM-dd\\'T\\'HH:mm:ss\\'Z\\''}}"
    },
    "transformers": ["response-template"]
  }
}
