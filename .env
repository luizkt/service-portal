# =============================================================================
# env.example — copie para .env e preencha os valores obrigatórios
# =============================================================================
#
# Gere as chaves obrigatórias com:
#   echo "PG_PASS=$(openssl rand -base64 36 | tr -d '\n')" >> .env
#   echo "AUTHENTIK_SECRET_KEY=$(openssl rand -base64 60 | tr -d '\n')" >> .env
#   echo "ORCHESTRATOR_JWT_SECRET=$(openssl rand -base64 60 | tr -d '\n')" >> .env
#
# =============================================================================

# --- PostgreSQL (Authentik) ---------------------------------------------------
PG_USER=authentik
PG_DB=authentik
PG_PASS=                            # OBRIGATÓRIO — max 99 chars

# --- Authentik ----------------------------------------------------------------
AUTHENTIK_SECRET_KEY=               # OBRIGATÓRIO — mínimo 50 chars aleatórios
AUTHENTIK_PORT_HTTP=9000
AUTHENTIK_PORT_HTTPS=9443
# Slug da aplicação OAuth2/OIDC criada no Authentik (passo 5 do primeiro uso).
# Padrão "service-portal" pode ser mantido se você criar a aplicação com esse slug.
AUTHENTIK_APP_SLUG=service-portal
# Client ID público da SPA cadastrado no Authentik (provider OAuth2/OIDC).
AUTHENTIK_CLIENT_ID=service-portal-spa

# --- MongoDB (Orchestrator) ---------------------------------------------------
MONGODB_DATABASE=generic-orchestrator

# --- RabbitMQ -----------------------------------------------------------------
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MANAGEMENT_PORT=15672      # Management UI: http://localhost:15672

# --- Orchestrator (Java / Spring Boot) ----------------------------------------
ORCHESTRATOR_INTERNAL_PORT=8080
ORCHESTRATOR_JWT_SECRET=            # OBRIGATÓRIO — mínimo 64 chars aleatórios
ORCHESTRATOR_USERNAME=admin         # Usuário de serviço do BFF → Orchestrator
ORCHESTRATOR_PASSWORD=admin         # Senha de serviço do BFF → Orchestrator
JWT_EXPIRATION=3600
JWT_ISSUER=generic-orchestrator

# --- Manager (Kotlin / Spring Boot) -------------------------------------------
# Dono da collection `workflows` no MongoDB
MANAGER_INTERNAL_PORT=8082
MANAGER_PORT=8082
# Por padrão reutiliza ORCHESTRATOR_JWT_SECRET — defina aqui se quiser segredo separado
MANAGER_JWT_SECRET=
MANAGER_JWT_ISSUER=service-portal-manager
MANAGER_ADMIN_USERNAME=admin
MANAGER_ADMIN_PASSWORD=admin

# --- BFF (Java / Spring Boot) -------------------------------------------------
BFF_INTERNAL_PORT=8081
BFF_PORT=8081

# --- Frontend (nginx) ---------------------------------------------------------
FRONTEND_INTERNAL_PORT=80
FRONTEND_PORT=80

# --- AWS / LocalStack (integrações QUEUE com provider SQS) -------------------
# LocalStack emula o SQS localmente; credenciais "test/test" são convencionais.
# Para usar SQS real, ajuste AWS_SQS_ENDPOINT (vazio = AWS) e as credenciais.
AWS_REGION=us-east-1
AWS_SQS_ENDPOINT=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_PORT=4566

# --- WireMock (simulador de APIs externas) ------------------------------------
# Porta do host para acessar a admin API e os stubs do WireMock.
# Internamente o container usa 8080; aliases de rede (ex.: api.exemplo.com) são
# resolvidos pelos demais containers via DNS do Docker — independem desta porta.
WIREMOCK_PORT=18080

# --- Autenticação M2M (provider confidencial do Authentik para testes) --------
# Esta instalação usa o provider existente "service-portal-cc".
# Em fresh installs com o blueprint, use: AUTHENTIK_M2M_APP_SLUG=service-portal-m2m
AUTHENTIK_M2M_APP_SLUG=service-portal-cc
AUTHENTIK_M2M_CLIENT_ID=service-portal-cc
AUTHENTIK_M2M_SECRET=test-secret-for-scripts

PG_PASS=HZX8i7+UTsGF4ROiu7y8mba1me0mlRe4LdVnY+ADBMBWOUBu
AUTHENTIK_SECRET_KEY=29osmMTcYcfKo/4Z60Xi1c4V8kRbwiayjkKUYwcDvOrG+/v0Fu/ldrwwQRPDKFEeHdJJtHZjC8IAucA1
ORCHESTRATOR_JWT_SECRET=dQi/jtseFzE7ijn0xyS1tHevRnsVKpCSGw042bDQafp1PZbE+teEQsmU7PW1bnfEP7If+LV81+BwiZKM
